# ============================================================
# InventarIA API — Variables de entorno (plantilla)
# Copiar este archivo como .env y completar los valores reales.
# El archivo .env NUNCA se sube a GitHub.
# ============================================================

# ── Base de datos SQL Server ─────────────────────────────────
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=InventarIA;encrypt=true;trustServerCertificate=true
DB_USER=
DB_PASSWORD=

# ── Proveedor de IA ──────────────────────────────────────────
# Ejemplo con OpenAI:
#   IA_BASE_URL=https://api.openai.com
#   IA_MODEL_TEXTO=gpt-4o-mini
#   IA_MODEL_VISION=gpt-4o
#
# Ejemplo con Google Gemini:
#   IA_BASE_URL=https://generativelanguage.googleapis.com
#   IA_MODEL_TEXTO=gemini-1.5-flash
#   IA_MODEL_VISION=gemini-1.5-flash
IA_API_KEY=
IA_BASE_URL=
IA_MODEL_TEXTO=
IA_MODEL_VISION=
